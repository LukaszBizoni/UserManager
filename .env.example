# Production settings default to false; manage.py uses development settings.
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace-with-a-long-random-production-secret
DJANGO_ALLOWED_HOSTS=example.com,www.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com

# Enable this only when a trusted reverse proxy sets X-Forwarded-Proto.
DJANGO_BEHIND_HTTPS_PROXY=true

# Enable these only after every listed subdomain supports HTTPS.
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false
